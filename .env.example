# Copy this file to .env and fill in your real values.
# .env is git-ignored; .env.example is the committed template.
#
# Load it into your shell before running the service, e.g.:
#   set -a && source .env && set +a && mvn compile exec:java

# --- Default: local open-source models via Ollama (no API key) ---
# application.conf defaults model-provider to `ollama`. Requires a running Ollama
# server (default http://localhost:11434) with the model pulled (`ollama pull qwen3:8b`).
# Optionally override the model (default qwen3:8b):
OLLAMA_MODEL=qwen3:8b

# --- Optional: use Google AI Gemini instead ---
# Uncomment MODEL_PROVIDER and set a real key (https://aistudio.google.com/app/apikey):
# MODEL_PROVIDER=googleai-gemini
# GOOGLE_AI_GEMINI_API_KEY=your-gemini-api-key
