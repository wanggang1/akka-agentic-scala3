<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.akka</groupId>
        <artifactId>akka-javasdk-parent</artifactId>
        <version>3.6.3</version>
    </parent>
    <groupId>com.gwgs</groupId>
    <artifactId>akka-agentic-scala3</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>akka-agentic-scala3</name>

    <properties>
        <scala.version>3.3.8</scala.version>
        <scala-maven-plugin.version>4.9.2</scala-maven-plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.scala-lang</groupId>
            <artifactId>scala3-library_3</artifactId>
            <version>${scala.version}</version>
        </dependency>
        <dependency>
            <groupId>io.akka</groupId>
            <artifactId>akka-javasdk-testkit</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Capability 8 (RAG): in-process embeddings + in-memory vector store. Both artifacts are
             ALREADY in the akka-javasdk 3.6.0 dependency tree (langchain4j 1.15.0 / embeddings
             1.15.0-beta25) - see specs/010 research R1. We only pin them at the SDK-aligned versions
             and promote them to compile scope so Scala source may reference InMemoryEmbeddingStore and
             AllMiniLmL6V2QuantizedEmbeddingModel. The ONNX model is packaged in-jar (no download, no
             network, no API key). -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-embeddings-all-minilm-l6-v2-q</artifactId>
            <version>1.15.0-beta25</version>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
            <version>1.15.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>net.alchim31.maven</groupId>
                <artifactId>scala-maven-plugin</artifactId>
                <version>${scala-maven-plugin.version}</version>
                <configuration>
                    <scalaVersion>${scala.version}</scalaVersion>
                    <!--
                      Compile ONLY Scala here. By default the plugin also joint-compiles the Java
                      sources (cap-2) via scalac/javac WITHOUT -parameters, clobbering the classes
                      maven-compiler-plugin produced correctly and breaking HTTP path-variable
                      binding. cap-1 (Scala) and cap-2 (Java) have no cross-references, so scalac
                      never needs the Java sources — leave Java entirely to maven-compiler-plugin.
                    -->
                    <sendJavaToScalac>true</sendJavaToScalac>
                    <!--
                      scalac joint-compiles the Java sources and emits their .class files too. Those
                      must ALSO carry -parameters, because on an INCREMENTAL build javac sees
                      scalac's fresh output as up to date, skips recompiling, and scalac's classes are
                      what ship. Without this, `mvn verify` (no clean) fails at startup with
                      "path expression [/x/{id}] does not match the method parameter name [arg0]"
                      while `mvn clean verify` passes — see specs/013 research R3.
                    -->
                    <javacArgs>
                        <javacArg>-parameters</javacArg>
                    </javacArgs>
                </configuration>
                <executions>
                    <execution>
                        <id>scala-compile</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>scala-test-compile</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
              Compiles the Java sources of capability 2 (com.gwgs.akkaagentic.team.*).
              `-proc:none` disables annotation processing: akka-javasdk-parent binds the
              ComponentAnnotationProcessor to javac, which would regenerate (and OVERWRITE)
              our hand-maintained META-INF component descriptor, dropping the Scala (cap-1)
              entries and the top-level service-setup. We keep that descriptor authoritative
              and list every component (Scala and Java) by hand. See specs/004 research R2.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <proc>none</proc>
                    <!--
                      Keep -parameters: the SDK binds HTTP path variables (e.g. /greetings/{id})
                      to method parameters by their reflected names. Overriding this plugin's
                      configuration drops the parent's compilerArgs, so restore it here or the
                      param compiles as `arg0` and path binding fails at startup.
                    -->
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          The inner-loop profile. `mvn test -Pquick` / `mvn verify -Pquick` drops two kinds of test:

            slow     - the test's cost is an unavoidable wall-clock wait, almost always to prove a
                       NEGATIVE (a cancelled timer never fires, a gate does not release, retries
                       stopped). You cannot prove a negative without waiting, so these are not
                       inefficiencies to be optimised away - do not "fix" their sleeps.
            testkit  - a unit-phase `*Test` that starts a whole Akka runtime. Five classes, 21.9 s of
                       the unit phase's 22.4 s; the other 39 classes together take 0.5 s.

          Tag filtering is honoured by the parent's surefire 2.22.2 and failsafe 3.1.2 (verified: a
          tagged class goes from 7 tests to 0). This profile is for the inner loop ONLY - the gate
          before calling work done, or pushing to a PR, is a full `mvn clean verify`. See CLAUDE.md
          "Choosing which tests to run".
        -->
        <profile>
            <id>quick</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <excludedGroups>slow,testkit</excludedGroups>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <excludedGroups>slow,testkit</excludedGroups>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
